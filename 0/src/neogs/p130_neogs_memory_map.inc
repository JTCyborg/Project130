; Project130 NeoGS physical RAM map.
; Adopted from Project126 by explicit decision on 2026-11-12.
; Physical pages are 16 KiB; this is not the Z80 logical window map.

P130_NGS_PAGE_SHIFT          EQU 14
P130_NGS_PAGE_SIZE           EQU #4000
P130_NGS_RAM_SIZE            EQU #400000
P130_NGS_PAGE_COUNT          EQU #100

P130_NGS_KERNEL_PAGE         EQU #00
P130_NGS_KERNEL_PAGES        EQU #10
P130_NGS_SYSBIOS_PAGE        EQU #10
P130_NGS_SYSBIOS_PAGES       EQU #10
P130_NGS_VGABIOS_PAGE        EQU #20
P130_NGS_VGABIOS_PAGES       EQU #10
P130_NGS_VRAM_PAGE           EQU #30
P130_NGS_VRAM_PAGES          EQU #10
P130_NGS_FRAME_PAGE          EQU #40
P130_NGS_FRAME_PAGES         EQU 2
P130_NGS_DMA_PAGE            EQU #42
P130_NGS_DMA_PAGES           EQU 1
P130_NGS_IPC_PAGE            EQU #43
P130_NGS_IPC_PAGES           EQU 1
P130_NGS_GUEST_RAM_PAGE      EQU #44
P130_NGS_GUEST_RAM_PAGES     EQU #40
P130_NGS_RESERVED_PAGE       EQU #84
P130_NGS_RESERVED_PAGES      EQU #7C

; Resident windows and selector encoding.
P130_NGS_OVERLAY_WINDOW_BASE EQU #8000
P130_NGS_OVERLAY_WINDOW_PORT EQU #00
P130_NGS_BANK_WINDOW_BASE    EQU #C000
P130_NGS_BANK_WINDOW_PORT    EQU #10

P130_NGS_X86IO_PAGE          EQU #04
P130_NGS_X86IO_SELECTOR      EQU #02
P130_NGS_X86ALU_PAGE         EQU #05
P130_NGS_X86ALU_SELECTOR     EQU #82
P130_NGS_X86DEV_PAGE         EQU #06
P130_NGS_X86DEV_SELECTOR     EQU #03
P130_NGS_X86EXEC_PAGE        EQU #07
P130_NGS_X86EXEC_SELECTOR    EQU #83
P130_NGS_X86VGA_PAGE         EQU #08
P130_NGS_X86VID_PAGE         EQU #09

P130_NGS_KERNEL_BASE         EQU P130_NGS_KERNEL_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_SYSBIOS_BASE        EQU P130_NGS_SYSBIOS_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_VGABIOS_BASE        EQU P130_NGS_VGABIOS_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_VRAM_BASE           EQU P130_NGS_VRAM_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_FRAME_BASE          EQU P130_NGS_FRAME_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_DMA_BASE            EQU P130_NGS_DMA_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_IPC_BASE            EQU P130_NGS_IPC_PAGE*P130_NGS_PAGE_SIZE
P130_NGS_GUEST_RAM_BASE      EQU P130_NGS_GUEST_RAM_PAGE*P130_NGS_PAGE_SIZE

        ASSERT P130_NGS_PAGE_SIZE = #4000
        ASSERT P130_NGS_PAGE_COUNT = #100
        ASSERT P130_NGS_KERNEL_PAGE+P130_NGS_KERNEL_PAGES = P130_NGS_SYSBIOS_PAGE
        ASSERT P130_NGS_SYSBIOS_PAGE+P130_NGS_SYSBIOS_PAGES = P130_NGS_VGABIOS_PAGE
        ASSERT P130_NGS_VGABIOS_PAGE+P130_NGS_VGABIOS_PAGES = P130_NGS_VRAM_PAGE
        ASSERT P130_NGS_VRAM_PAGE+P130_NGS_VRAM_PAGES = P130_NGS_FRAME_PAGE
        ASSERT P130_NGS_FRAME_PAGE+P130_NGS_FRAME_PAGES = P130_NGS_DMA_PAGE
        ASSERT P130_NGS_DMA_PAGE+P130_NGS_DMA_PAGES = P130_NGS_IPC_PAGE
        ASSERT P130_NGS_IPC_PAGE+P130_NGS_IPC_PAGES = P130_NGS_GUEST_RAM_PAGE
        ASSERT P130_NGS_GUEST_RAM_PAGE+P130_NGS_GUEST_RAM_PAGES = P130_NGS_RESERVED_PAGE
        ASSERT P130_NGS_RESERVED_PAGE+P130_NGS_RESERVED_PAGES = P130_NGS_PAGE_COUNT
        ASSERT P130_NGS_SYSBIOS_PAGES*P130_NGS_PAGE_SIZE = #40000
        ASSERT P130_NGS_GUEST_RAM_PAGES*P130_NGS_PAGE_SIZE = #100000
