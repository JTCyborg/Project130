; Project130 initial Intel 8086 Real Mode guest physical memory map.
; Adopted from Project126 by explicit decision on 2026-11-12.
; Guest physical addresses are 20-bit and wrap at 1 MiB.

P130_X86_ADDRESS_SPACE_SIZE EQU #100000
P130_X86_ADDRESS_SPACE_MASK EQU #0FFFFF
P130_X86_RAM_LOW_BASE       EQU #00000
P130_X86_RAM_LOW_SIZE       EQU #A0000
P130_X86_VGA_BASE           EQU #A0000
P130_X86_VGA_SIZE           EQU #20000
P130_X86_VGABIOS_BASE       EQU #C0000
P130_X86_VGABIOS_SIZE       EQU #08000
P130_X86_RAM_HIGH_BASE      EQU #C8000
P130_X86_RAM_HIGH_SIZE      EQU #36000
P130_X86_SYSBIOS_BASE       EQU #FE000
P130_X86_SYSBIOS_SIZE       EQU #02000
P130_X86_SYSBIOS_MAX_IMAGE  EQU #40000

P130_X86_MEM_RAM_LOW        EQU 0
P130_X86_MEM_VGA            EQU 1
P130_X86_MEM_VGABIOS        EQU 2
P130_X86_MEM_RAM_HIGH       EQU 3
P130_X86_MEM_SYSBIOS        EQU 4

        ASSERT P130_X86_ADDRESS_SPACE_SIZE = #100000
        ASSERT P130_X86_RAM_LOW_BASE+P130_X86_RAM_LOW_SIZE = P130_X86_VGA_BASE
        ASSERT P130_X86_VGA_BASE+P130_X86_VGA_SIZE = P130_X86_VGABIOS_BASE
        ASSERT P130_X86_VGABIOS_BASE+P130_X86_VGABIOS_SIZE = P130_X86_RAM_HIGH_BASE
        ASSERT P130_X86_RAM_HIGH_BASE+P130_X86_RAM_HIGH_SIZE = P130_X86_SYSBIOS_BASE
        ASSERT P130_X86_SYSBIOS_BASE+P130_X86_SYSBIOS_SIZE = P130_X86_ADDRESS_SPACE_SIZE
        ASSERT P130_X86_SYSBIOS_MAX_IMAGE <= #40000
