; PROJECT126 guest Intel 8086 memory and ATM-PC/XT-hybrid profile v0.1
; Guest physical addresses are 20-bit, byte-addressed, 00000h..FFFFFh.
; This is the guest-visible map; do not confuse it with NeoGS physical RAM.

P126_X86_ADDRESS_SPACE_SIZE     EQU #100000
P126_X86_ADDRESS_SPACE_MASK     EQU #0FFFFF
P126_X86_RAM_BACKING_SIZE       EQU #100000

; Guest memory regions: half-open ranges [BASE, BASE+SIZE).
P126_X86_RAM_LOW_BASE           EQU #00000
P126_X86_RAM_LOW_SIZE           EQU #A0000
P126_X86_VGA_APERTURE_BASE      EQU #A0000
P126_X86_VGA_APERTURE_SIZE      EQU #20000
P126_X86_VGABIOS_BASE           EQU #C0000
P126_X86_VGABIOS_SIZE           EQU #08000
P126_X86_RAM_HIGH_BASE          EQU #C8000
P126_X86_RAM_HIGH_SIZE          EQU #36000
P126_X86_SYSBIOS_BASE           EQU #FE000
P126_X86_SYSBIOS_SIZE           EQU #02000

; Read/write classifier return values.
P126_X86_MEM_RAM_LOW            EQU 0
P126_X86_MEM_VGA_APERTURE       EQU 1
P126_X86_MEM_VGABIOS            EQU 2
P126_X86_MEM_RAM_HIGH           EQU 3
P126_X86_MEM_SYSBIOS            EQU 4

; BIOS image policy. Physical image storage is in the separate 256 KiB
; NeoGS BIOS slot. Initial XT-compatible ROM images are 8 KiB and map here.
P126_X86_SYSBIOS_MAX_IMAGE      EQU #40000
P126_X86_SYSBIOS_BOOT_IMAGE     EQU #02000

; ATM-PC/XT hybrid I/O decode assignments. Device implementations are
; software models on NeoGS; no physical NeoGS IN/OUT is permitted.
P126_X86_IO_DMA_BASE            EQU #0000
P126_X86_IO_DMA_SIZE            EQU #0010
P126_X86_IO_PIC_BASE            EQU #0020
P126_X86_IO_PIC_SIZE            EQU #0002
P126_X86_IO_PIT_BASE            EQU #0040
P126_X86_IO_PIT_SIZE            EQU #0004
P126_X86_IO_PPI_BASE            EQU #0060
P126_X86_IO_PPI_SIZE            EQU #0004
P126_X86_IO_RTC_BASE            EQU #0070
P126_X86_IO_RTC_SIZE            EQU #0002
P126_X86_IO_DMA_PAGE_BASE       EQU #0080
P126_X86_IO_DMA_PAGE_SIZE       EQU #0004
P126_X86_IO_IDE_BASE            EQU #01F0
P126_X86_IO_IDE_SIZE            EQU #0008
P126_X86_IO_VGA_MONO_BASE       EQU #03B0
P126_X86_IO_VGA_COLOR_BASE      EQU #03D0
P126_X86_IO_VGA_SIZE            EQU #0030
P126_X86_IO_FDC_BASE            EQU #03F0
P126_X86_IO_FDC_SIZE            EQU #0006
P126_X86_IO_FDC_DIR             EQU #03F7
P126_X86_IO_IDE_CTRL            EQU #03F6

; Compile-time guest map integrity.
        ASSERT P126_X86_ADDRESS_SPACE_SIZE = #100000
        ASSERT P126_X86_RAM_BACKING_SIZE = P126_X86_ADDRESS_SPACE_SIZE
        ASSERT P126_X86_RAM_LOW_BASE = 0
        ASSERT P126_X86_RAM_LOW_BASE+P126_X86_RAM_LOW_SIZE = P126_X86_VGA_APERTURE_BASE
        ASSERT P126_X86_VGA_APERTURE_BASE+P126_X86_VGA_APERTURE_SIZE = P126_X86_VGABIOS_BASE
        ASSERT P126_X86_VGABIOS_BASE+P126_X86_VGABIOS_SIZE = P126_X86_RAM_HIGH_BASE
        ASSERT P126_X86_RAM_HIGH_BASE+P126_X86_RAM_HIGH_SIZE = P126_X86_SYSBIOS_BASE
        ASSERT P126_X86_SYSBIOS_BASE+P126_X86_SYSBIOS_SIZE = P126_X86_ADDRESS_SPACE_SIZE
        ASSERT P126_X86_RAM_LOW_SIZE = #A0000
        ASSERT P126_X86_RAM_HIGH_SIZE = #36000
        ASSERT P126_X86_SYSBIOS_MAX_IMAGE <= #40000
        ASSERT P126_X86_SYSBIOS_BOOT_IMAGE = P126_X86_SYSBIOS_SIZE
