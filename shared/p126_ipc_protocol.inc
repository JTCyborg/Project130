; =========================================================================
; PROJECT126 — shared DMA/IPC ABI constants
; Version: P126 DMA/IPC ABI 1.1
; This file contains protocol constants only; no host or NeoGS port I/O.
; =========================================================================

P126_IPC_MAJOR             EQU 1
P126_IPC_MINOR             EQU 1
P126_IPC_HEADER_SIZE       EQU 18
P126_IPC_MAX_FRAME_SIZE    EQU #4000
P126_IPC_MAX_PAYLOAD       EQU P126_IPC_MAX_FRAME_SIZE-P126_IPC_HEADER_SIZE
P126_IPC_FRAGMENT_HEADER   EQU 10
P126_IPC_MAX_FRAGMENT_DATA EQU P126_IPC_MAX_PAYLOAD-P126_IPC_FRAGMENT_HEADER

; Fixed header offsets.
P126_IPC_OFF_MAGIC        EQU 0
P126_IPC_OFF_MAJOR        EQU 4
P126_IPC_OFF_MINOR        EQU 5
P126_IPC_OFF_TYPE         EQU 6
P126_IPC_OFF_SERVICE      EQU 7
P126_IPC_OFF_OPERATION    EQU 8
P126_IPC_OFF_FLAGS        EQU 9
P126_IPC_OFF_SEQUENCE     EQU 10
P126_IPC_OFF_LENGTH       EQU 12
P126_IPC_OFF_STATUS       EQU 14
P126_IPC_OFF_CRC          EQU 16

; Message types.
P126_MSG_REQUEST          EQU #01
P126_MSG_RESPONSE         EQU #02
P126_MSG_EVENT            EQU #03
P126_MSG_CANCEL           EQU #04

; Header flags.
P126_FLAG_ACK_REQUIRED    EQU #01
P126_FLAG_FRAGMENT        EQU #02
P126_FLAG_IDEMPOTENT      EQU #04
P126_FLAG_VALID_MASK      EQU #07

; GSCOM control-plane commands. Valid only under Project126 resident firmware.
P126_CMD_HOST_FRAME       EQU #E0
P126_CMD_NGS_FRAME        EQU #E1
P126_CMD_NGS_VIDEO_FRAME  EQU #E4
P126_CMD_RESYNC           EQU #E2
P126_CMD_CAPABILITIES     EQU #E3
P126_CMD_DMA_END          EQU #FF

; Service IDs.
P126_SERVICE_SESSION      EQU #00
P126_SERVICE_INPUT        EQU #01
P126_SERVICE_VIDEO        EQU #02
P126_SERVICE_STORAGE      EQU #03
P126_SERVICE_CLOCK        EQU #04
P126_SERVICE_DIAGNOSTICS  EQU #05
P126_SERVICE_CONFIG       EQU #06
P126_SERVICE_IMAGE        EQU #07

; Initial operation IDs.
P126_OP_HELLO             EQU #00
P126_OP_CAPABILITIES      EQU #01
P126_OP_RESYNC            EQU #02
P126_OP_DIAGNOSTIC        EQU #00
P126_OP_IMAGE_BEGIN       EQU #00
P126_OP_IMAGE_FRAGMENT    EQU #01
P126_OP_IMAGE_FINISH      EQU #02
P126_OP_IMAGE_RESULT      EQU #03
P126_OP_INPUT_KEYBOARD     EQU #00

; Video service operations and mode descriptor ABI.
P126_OP_VIDEO_MODE         EQU #00
P126_OP_VIDEO_FRAME_REQUEST EQU #01
P126_OP_VIDEO_FRAME          EQU #02
P126_OP_VIDEO_FRAME_FRAGMENT EQU #03
P126_OP_VIDEO_FRAME_FINISH   EQU #04
P126_VIDEO_MODE_DESC_SIZE  EQU 8
P126_VIDEO_DESC_VERSION    EQU 1
P126_VIDEO_FORMAT_TEXT80X25 EQU 1
P126_ATM_MODE_RG6_TEXT80X25 EQU 6
; Public ATM-side renderer mode name used by the screen-console and IPC modules.
P126_ATM_VIDEO_MODE_RG6_TEXT80X25 EQU P126_ATM_MODE_RG6_TEXT80X25
P126_VIDEO_TEXT80_WIDTH    EQU 80
P126_VIDEO_TEXT80_HEIGHT   EQU 25
P126_VIDEO_TEXT80_CELLS    EQU 2000
P126_VIDEO_TEXT80_FRAME_SIZE EQU 4000

; Response status codes (16-bit values).
P126_STATUS_OK            EQU #0000
P126_STATUS_BAD_MAGIC     EQU #0001
P126_STATUS_BAD_VERSION   EQU #0002
P126_STATUS_BAD_FRAME     EQU #0003
P126_STATUS_CRC_ERROR     EQU #0004
P126_STATUS_SEQUENCE      EQU #0005
P126_STATUS_NO_SERVICE    EQU #0006
P126_STATUS_NO_OPERATION  EQU #0007
P126_STATUS_NO_BUFFER     EQU #0008
P126_STATUS_HOST_IO       EQU #0009
P126_STATUS_TIMEOUT       EQU #000A
P126_STATUS_CANCELLED     EQU #000B
P126_STATUS_ADDRESS_RANGE EQU #000C
P126_STATUS_BUSY          EQU #000D
P126_STATUS_RESET_REQUIRED EQU #000E
P126_STATUS_BAD_FRAGMENT  EQU #000F

; CRC-16/CCITT-FALSE.
P126_CRC16_POLY           EQU #1021
P126_CRC16_INITIAL_H      EQU #FF
P126_CRC16_INITIAL_L      EQU #FF
P126_CRC16_CHECK_H        EQU #29
P126_CRC16_CHECK_L        EQU #B1


; IMAGE service v1.1 image profiles.
; IMAGE_BEGIN payload: message-id u16, image-kind u8, physical-page u8,
; exact image-size u16. The receiver validates kind/page policy and derives
; the WIN3/MPAGEX selector from ROR8(physical-page).
; SYSBIOS: 8 KiB image to physical page 10h. X86 overlays retain their
; pinned page assignments 04h..07h until the resident module manager owns
; allocation of the dynamic page range.
P126_IMAGE_KIND_SYSBIOS      EQU #00
P126_IMAGE_KIND_X86IO        EQU #01
P126_IMAGE_KIND_X86ALU       EQU #02
P126_IMAGE_KIND_X86DEV       EQU #03
P126_IMAGE_KIND_X86EXEC      EQU #04
P126_IMAGE_KIND_X86VGA       EQU #05
P126_IMAGE_KIND_X86VID       EQU #06
P126_IMAGE_X86IO_MAX_SIZE    EQU #1000
P126_IMAGE_X86ALU_MAX_SIZE   EQU #1000
P126_IMAGE_X86DEV_MAX_SIZE   EQU #1000
P126_IMAGE_X86EXEC_MAX_SIZE  EQU #4000
P126_IMAGE_X86VGA_MAX_SIZE   EQU #4000
P126_IMAGE_X86VID_MAX_SIZE   EQU #4000
P126_IMAGE_SYSBIOS_SIZE      EQU #2000
P126_IMAGE_FRAGMENT_EXT_SIZE EQU 10
